/// The `sys` module provides system-level capabilities and interpreter control.
///
/// Example:
/// ```vv
/// import sys from "std/sys.vv"
/// import console from "std/console.vv"
///
/// console.print(sys.type(123)) // "int"
/// ```


/// Prints help information about the language and available built-ins.
///
/// Example:
/// ```vv
/// sys.help()
/// ```
pub extern "native" fun help()

/// Checks if two values refer to the exact same object in memory (physical equality).
///
/// Example:
/// ```vv
/// import sys from "std/sys.vv"
/// import console from "std/console.vv"
///
/// let a = [1]
/// let b = [1]
/// console.print(sys.phys_eq(a, b)) // false
/// console.print(sys.phys_eq(a, a)) // true
/// ```
pub extern "native" fun phys_eq(a, b)

test "phys_eq"
    let a = [1]
    let b = [1]
    assert phys_eq(a, a) == true
    assert phys_eq(a, b) == false
end

/// Sets the maximum recursion depth allowed by the interpreter.
/// Prevents stack overflow panics by throwing a catchable runtime error instead.
///
/// Example:
/// ```vv
/// sys.set_max_recursion_depth(100)
/// ```
pub extern "native" fun set_max_recursion_depth(depth)

/// Returns the current maximum recursion depth allowed by the interpreter.
///
/// Example:
/// ```vv
/// import sys from "std/sys.vv"
/// import console from "std/console.vv"
///
/// console.print(sys.get_max_recursion_depth()) // 1000
/// ```
pub extern "native" fun get_max_recursion_depth()

test "set_max_recursion_depth / get_max_recursion_depth"
    let prev = get_max_recursion_depth()
    set_max_recursion_depth(500)
    assert get_max_recursion_depth() == 500
    set_max_recursion_depth(prev)
end

/// Returns the string representation of the type of the given value.
///
/// Example:
/// ```vv
/// import sys from "std/sys.vv"
/// import console from "std/console.vv"
///
/// console.print(sys.type(123)) // "int"
/// console.print(sys.type("hello")) // "list"
/// console.print(sys.type({ a = 1 })) // "record"
/// ```
pub extern "native" fun type(v)

test "type"
    assert type(1) == "int"
    assert type(1.0) == "float"
    assert type(true) == "bool"
    assert type("hi") == "list"
    assert type([]) == "list"
    assert type({ a = 1 }) == "record"
end

/// Returns the string representation of the given value.
///
/// Example:
/// ```vv
/// import sys from "std/sys.vv"
/// import console from "std/console.vv"
///
/// console.print(sys.str(123)) // "123"
/// console.print(sys.str([1, 2, 3])) // "[1, 2, 3]"
/// console.print(sys.str(true)) // "true"
/// ```
pub extern "native" fun str(v)

test "str"
    assert str(123) == "123"
    assert str(true) == "true"
end
