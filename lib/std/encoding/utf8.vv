/// The `encoding/utf8` module provides UTF-8 encoding and decoding utilities.
///
/// Example:
/// ```vv
/// import utf8 from "std/encoding/utf8.vv"
///
/// let bytes = utf8.encode('A')
/// let res = utf8.decode(bytes)!
/// console.print(res.char) // 'A'
/// ```


/// Encodes a character to a list of UTF-8 bytes.
pub extern "native" fun encode(c)

test "encode"
    assert encode('a') == [97]
    assert encode('€') == [226, 130, 172]
    assert encode('𠮷') == [240, 160, 174, 183]
end

/// Decodes a list of bytes to a character.
///
/// - `bytes`: A list of integers representing UTF-8 bytes.
///
/// Returns a result containing a record `{ char = c, size = n }` or an error.
pub extern "native" fun decode(bytes)

test "decode"
    let d1 = decode([97])
    assert d1.type == "ok"
    assert d1.value.char == 'a'
    assert d1.value.size == 1

    let d2 = decode([226, 130, 172])
    assert d2.type == "ok"
    assert d2.value.char == '€'
    assert d2.value.size == 3

    let d3 = decode([240, 160, 174, 183])
    assert d3.type == "ok"
    assert d3.value.char == '𠮷'
    assert d3.value.size == 4
end

test "decode error"
    let d1 = decode([])
    assert d1.type == "error"

    let d2 = decode([226, 130])
    assert d2.type == "error"
end
