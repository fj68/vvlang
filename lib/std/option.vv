/// The `option` module provides a way to represent optional values.
/// An `option` value is either `some(value)` or `none`.
///
/// Example:
/// ```vv
/// import option from "std/option.vv"
///
/// let val = option.some(42)
/// let empty = option.none
/// ```


/// Represents the absence of a value.
///
/// Example:
/// ```vv
/// let empty = option.none
/// ```
pub let none = { type = "none" }

/// Wraps a value in an `option`.
///
/// Example:
/// ```vv
/// let some_val = option.some(42)
/// ```
pub fun some(value)
  return { type = "some", value = value }
end

test "some"
    let v = some(42)
    assert v.type == "some"
    assert v.value == 42
end

/// Checks if an `option` contains a value.
///
/// Example:
/// ```vv
/// option.is_some(option.some(1)) // true
/// option.is_some(option.none)    // false
/// ```
pub fun is_some(v)
   return v.type == "some"
end

test "is_some"
    assert is_some(some(1)) == true
    assert is_some(none) == false
end

/// Checks if an `option` is empty (`none`).
///
/// Example:
/// ```vv
/// option.is_none(option.none)    // true
/// option.is_none(option.some(1)) // false
/// ```
pub fun is_none(v)
   return v.type == "none"
end

test "is_none"
    assert is_none(none) == true
    assert is_none(some(1)) == false
end

/// Returns the wrapped value if it exists, otherwise returns the provided `default_value`.
///
/// Example:
/// ```vv
/// option.get_or(option.some(1), 0) // 1
/// option.get_or(option.none, 0)    // 0
/// ```
pub fun get_or(v, default_value)
  if is_some(v)
    return v.value
  end
  return default_value
end

test "get_or"
    assert get_or(some(1), 0) == 1
    assert get_or(none, 0) == 0
    assert get_or(none, "default") == "default"
end

/// Applies a function to the wrapped value if it exists, returning a new `option`.
///
/// Example:
/// ```vv
/// option.map(option.some(2), fun(x) x * 2 end) // some(4)
/// option.map(option.none, fun(x) x * 2 end)    // none
/// ```
pub fun map(v, f)
  if is_some(v)
    return some(f(v.value))
  end
  return v
end

test "map"
    let double = fun(x) x * 2 end
    let r1 = map(some(3), double)
    assert r1.type == "some"
    assert r1.value == 6
    let r2 = map(none, double)
    assert r2.type == "none"
end

/// Applies a function that returns an `option` to the wrapped value.
///
/// Example:
/// ```vv
/// let f = fun(x) option.some(x + 1) end
/// option.flat_map(option.some(1), f) // some(2)
/// ```
pub fun flat_map(v, f)
  if is_some(v)
    return f(v.value)
  end
  return v
end

test "flat_map"
    let f = fun(x) some(x + 1) end
    let r1 = flat_map(some(1), f)
    assert r1.type == "some"
    assert r1.value == 2
    let r2 = flat_map(none, f)
    assert r2.type == "none"
end

/// Applies a function if the `option` is `none`. Useful for chaining fallbacks.
///
/// Example:
/// ```vv
/// option.flat_map_none(option.none, fun() option.some(1) end) // some(1)
/// ```
pub fun flat_map_none(v, f)
  if is_some(v)
    return v
  end
  return f(v.value)
end

test "flat_map_none"
    let fallback = fun() some(99) end
    let r1 = flat_map_none(none, fallback)
    assert r1.type == "some"
    assert r1.value == 99
    let r2 = flat_map_none(some(1), fallback)
    assert r2.type == "some"
    assert r2.value == 1
end
