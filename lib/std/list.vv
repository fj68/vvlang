pub extern "native" fun push(l, v)
pub extern "native" fun pop(l)
pub extern "native" fun shift(l)
pub extern "native" fun unshift(l, v)
pub extern "native" fun replace(xs, from_pattern, to_pattern)

pub fun each(xs, f)
    let i = 0
    while i < len(xs)
        f(i, xs[i])
        i = i + 1
    end
end

pub fun map(xs, f)
  let rs = []
  each(xs, fun (i, x)
    push(rs, f(i, x))
  end)
  return rs
end

pub fun filter(xs, f)
  let rs = []
  each(xs, fun (i, x)
    if f(i, x)
      push(rs, x)
    end
  end)
  return rs
end

pub fun reverse(xs)
  let rs = []
  let i = len(xs) - 1
  while 0 <= i
    push(rs, xs[i])
    i -= 1
  end
  return rs
end

pub fun fold_left(xs, init, f)
  let rs = init
  each(xs, fun (i, x)
    rs = f(rs, i, x)
  end)
  return rs
end

pub fun fold_right(xs, init, f)
  let rs = init
  let i = len(xs) - 1
  while 0 <= i
    rs = f(rs, i, xs[i])
    i -= 1
  end
  return rs
end

pub fun head(xs)
  if len(xs) == 0
    return nil
  end
  return xs[0]
end

pub fun tail(xs)
  if len(xs) == 0
    return nil
  end
  return xs[1:]
end

pub fun flat(xs)
  let rs = []
  each(xs, fun (_, x)
    if type(x) == "list"
      each(x, fun (_, y)
        push(rs, y)
      end)
    else
      push(rs, x)
    end
  end)
  return rs
end

pub fun flat_map(xs, f)
  flat(map(xs, f))
end

pub fun join(xs, sep)
  let rs = []
  each(xs, fun (i, x)
    if 0 < i
      push(rs, sep)
    end
    push(rs, x)
  end)
  return rs
end

pub fun init(n, f)
  let rs = []
  let i = 0
  while i < n
    push(rs, f(i))
    i += 1
  end
  return rs
end

pub fun max(xs, f)
  let m = xs[0]
  each(xs, fun (_, x)
    if f(m) < f(x)
      m = x
    end
  end)
  return m
end

pub fun min(xs, f)
  let m = xs[0]
  each(xs, fun (_, x)
    if f(x) < f(m)
      m = x
    end
  end)
  return m
end

pub fun partition(xs, f)
  let ys = []
  let zs = []
  each(xs, fun (i, x)
    if f(i, x)
      push(ys, x)
    else
      push(zs, x)
    end
  end)
  return [ys, zs]
end

pub fun zip(xs, ys)
  let rs = []
  let i = 0
  let length = max([len(xs), len(ys)], fun (it) return it end)
  while i < length
    let x = null
    if i < len(xs)
      x = xs[i]
    end

    let y = null
    if i < len(ys)
      y = ys[i]
    end

    push(rs, [x, y])

    i += 1
  end
  return rs
end

pub fun every(xs, f)
  let i = 0
  while i < len(xs)
    if not(f(i, xs[i]))
      return false
    end
    i += 1
  end
  return true
end

pub fun some(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return true
    end
    i += 1
  end
  return false
end

pub fun find(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return xs[i]
    end
    i += 1
  end
  return nil
end

pub fun find_index(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return i
    end
    i += 1
  end
  return -1
end

pub fun find_pattern(xs, ys)
  let i = 0
  while i < len(xs)
    if xs[i] == ys[0]
      let j = 1
      while j < len(ys)
        if not(xs[i + j] == ys[j])
          break
        end
        j = j + 1
      end
      if j == len(ys)
        return i
      end
    end
    i += 1
  end
  return -1
end

pub fun take_while(xs, f)
  let rs = []
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      push(rs, xs[i])
    else
      break
    end
    i += 1
  end
  return rs
end

pub fun drop_while(xs, f)
  let rs = []
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      i += 1
    else
      break
    end
  end
  while i < len(xs)
    push(rs, xs[i])
    i += 1
  end
  return rs
end
