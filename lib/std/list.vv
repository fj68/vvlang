/// The `list` module provides utilities for working with lists (arrays).
/// Lists are ordered, mutable collections of elements of any type.
///
/// Example:
/// ```vv
/// import list from "std/list.vv"
///
/// let l = [1, 2, 3]
/// list.push(l, 4)
/// let doubled = list.map(l, fun (i, x) return x * 2 end)
/// ```

import option from "std/option.vv"
import sys from "std/sys.vv"

/// Adds a value to the end of a list.
/// Returns the modified list.
///
/// Example:
/// ```vv
/// let l = [1, 2]
/// list.push(l, 3) // [1, 2, 3]
/// ```
pub extern "native" fun push(l, v)

test "push"
    let l = [1, 2]
    push(l, 3)
    assert l == [1, 2, 3]
end

/// Removes and returns the last element from a list.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// let v = list.pop(l) // 3
/// // l is now [1, 2]
/// ```
pub extern "native" fun pop(l)

test "pop"
    let l = [1, 2, 3]
    let v = pop(l)
    assert v == 3
    assert l == [1, 2]
end

/// Removes and returns the first element from a list.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// let v = list.shift(l) // 1
/// // l is now [2, 3]
/// ```
pub extern "native" fun shift(l)

test "shift"
    let l = [10, 20, 30]
    let v = shift(l)
    assert v == 10
    assert l == [20, 30]
end

/// Adds a value to the beginning of a list.
/// Returns the modified list.
///
/// Example:
/// ```vv
/// let l = [2, 3]
/// list.unshift(l, 1) // [1, 2, 3]
/// ```
pub extern "native" fun unshift(l, v)

test "unshift"
    let l = [2, 3]
    unshift(l, 1)
    assert l == [1, 2, 3]
end

/// Replaces occurrences of a sub-list pattern within a list with another pattern.
/// Returns a new list.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 2, 3, 4]
/// let r = list.replace(l, [2, 3], [5, 6]) // [1, 5, 6, 5, 6, 4]
/// ```
pub extern "native" fun replace(xs, from_pattern, to_pattern)

test "replace"
    let xs = [1, 2, 3, 2, 4]
    assert replace(xs, [2], [9, 9]) == [1, 9, 9, 3, 9, 9, 4]
    assert replace([1, 2, 3, 1, 2, 3], [1, 2], [0]) == [0, 3, 0, 3]
end

/// Iterates over each element in a list and applies a function to it.
/// The applied function receives the index and the element as arguments.
///
/// Example:
/// ```vv
/// let l = ["a", "b"]
/// list.each(l, fun (i, x) console.print(x) end)
/// ```
pub fun each(xs, f)
    let i = 0
    while i < len(xs)
        f(i, xs[i])
        i = i + 1
    end
end

test "each"
    let result = []
    each([10, 20, 30], fun (i, x)
        push(result, x * 2)
    end)
    assert result == [20, 40, 60]
end

/// Returns a new list with the results of applying a function to every element.
/// The applied function receives the index and the element as arguments.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.map(l, fun (i, x) return x * 2 end) // [2, 4, 6]
/// ```
pub fun map(xs, f)
  let rs = []
  each(xs, fun (i, x)
    push(rs, f(i, x))
  end)
  return rs
end

test "map"
    let r = map([1, 2, 3], fun (i, x) return x * 2 end)
    assert r == [2, 4, 6]
end

/// Returns a new list containing only elements that satisfy the provided testing function.
/// The testing function receives the index and the element as arguments.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 4]
/// list.filter(l, fun (i, x) return x % 2 == 0 end) // [2, 4]
/// ```
pub fun filter(xs, f)
  let rs = []
  each(xs, fun (i, x)
    if f(i, x)
      push(rs, x)
    end
  end)
  return rs
end

test "filter"
    let r = filter([1, 2, 3, 4], fun (i, x) return x % 2 == 0 end)
    assert r == [2, 4]
end

/// Returns a new list with the elements of the original list in reverse order.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.reverse(l) // [3, 2, 1]
/// ```
pub fun reverse(xs)
  let rs = []
  let i = len(xs) - 1
  while 0 <= i
    push(rs, xs[i])
    i -= 1
  end
  return rs
end

test "reverse"
    assert reverse([1, 2, 3]) == [3, 2, 1]
    assert reverse([]) == []
    assert reverse([42]) == [42]
end

/// Applies a function against an accumulator and each element (from left to right) to reduce it to a single value.
/// The applied function receives the accumulator, the index, and the element as arguments.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.fold_left(l, 0, fun (acc, i, x) return acc + x end) // 6
/// ```
pub fun fold_left(xs, init, f)
  let rs = init
  each(xs, fun (i, x)
    rs = f(rs, i, x)
  end)
  return rs
end

test "fold_left"
    let sum = fold_left([1, 2, 3], 0, fun (acc, i, x) return acc + x end)
    assert sum == 6
    let str = fold_left(["a", "b", "c"], "", fun (acc, i, x) return acc + x end)
    assert str == "abc"
end

/// Applies a function against an accumulator and each element (from right to left) to reduce it to a single value.
/// The applied function receives the accumulator, the index, and the element as arguments.
///
/// Example:
/// ```vv
/// let l = ["a", "b", "c"]
/// list.fold_right(l, "", fun (acc, i, x) return acc + x end) // "cba"
/// ```
pub fun fold_right(xs, init, f)
  let rs = init
  let i = len(xs) - 1
  while 0 <= i
    rs = f(rs, i, xs[i])
    i -= 1
  end
  return rs
end

test "fold_right"
    let str = fold_right(["a", "b", "c"], "", fun (acc, i, x) return acc + x end)
    assert str == "cba"
end

/// Returns the first element of a list.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.head(l) // 1
/// ```
pub fun head(xs)
  if len(xs) == 0
    return option.none
  end
  return option.some(xs[0])
end

test "head"
    assert head([1, 2, 3]) == option.some(1)
    assert head([]) == option.none
end

/// Returns a new list containing all elements except the first one.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.tail(l) // [2, 3]
/// ```
pub fun tail(xs)
  if len(xs) == 0
    return option.none
  end
  return option.some(xs[1:])
end

test "tail"
    assert tail([1, 2, 3]) == option.some([2, 3])
    assert tail([1]) == option.some([])
    assert tail([]) == option.none
end

/// Flattens a list of lists into a single continuous list.
/// Note: Only flattens exactly one level deep.
///
/// Example:
/// ```vv
/// let l = [[1, 2], [3, 4]]
/// list.flat(l) // [1, 2, 3, 4]
/// ```
pub fun flat(xs)
  let rs = []
  each(xs, fun (_, x)
    if sys.type(x) == "list"
      each(x, fun (_, y)
        push(rs, y)
      end)
    else
      push(rs, x)
    end
  end)
  return rs
end

test "flat"
    assert flat([[1, 2], [3, 4]]) == [1, 2, 3, 4]
    assert flat([[1], [], [2, 3]]) == [1, 2, 3]
end

/// Maps a function over a list and optionally flattens the result by one level.
///
/// Example:
/// ```vv
/// let l = [1, 2]
/// list.flat_map(l, fun (i, x) return [x, x * 2] end) // [1, 2, 2, 4]
/// ```
pub fun flat_map(xs, f)
  return flat(map(xs, f))
end

test "flat_map"
    let r = flat_map([1, 2], fun (i, x) return [x, x * 2] end)
    assert r == [1, 2, 2, 4]
end

/// Joins all elements of a list, placing the provided separator between each element.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.join(l, 0) // [1, 0, 2, 0, 3]
/// ```
pub fun join(xs, sep)
  let rs = []
  each(xs, fun (i, x)
    if 0 < i
      push(rs, sep)
    end
    push(rs, x)
  end)
  return rs
end

test "join"
    assert join([1, 2, 3], 0) == [1, 0, 2, 0, 3]
    assert join([], 0) == []
    assert join([1], 0) == [1]
end

/// Creates a list of size `n`, initializing each element using the function `f(index)`.
///
/// Example:
/// ```vv
/// list.init(3, fun (i) return i * 2 end) // [0, 2, 4]
/// ```
pub fun init(n, f)
  let rs = []
  let i = 0
  while i < n
    push(rs, f(i))
    i += 1
  end
  return rs
end

test "init"
    assert init(3, fun (i) return i * 2 end) == [0, 2, 4]
    assert init(0, fun (i) return i end) == []
end

/// Returns the element that produces the maximum value when `f(element)` is applied.
///
/// Example:
/// ```vv
/// let l = [1, 5, 2]
/// list.max(l, fun (x) return x end) // 5
/// ```
pub fun max(xs, f)
  let m = xs[0]
  each(xs, fun (_, x)
    if f(m) < f(x)
      m = x
    end
  end)
  return m
end

test "max"
    assert max([1, 5, 2], fun (x) return x end) == 5
    assert max([3], fun (x) return x end) == 3
end

/// Returns the element that produces the minimum value when `f(element)` is applied.
///
/// Example:
/// ```vv
/// let l = [1, 5, 2]
/// list.min(l, fun (x) return x end) // 1
/// ```
pub fun min(xs, f)
  let m = xs[0]
  each(xs, fun (_, x)
    if f(x) < f(m)
      m = x
    end
  end)
  return m
end

test "min"
    assert min([1, 5, 2], fun (x) return x end) == 1
    assert min([3], fun (x) return x end) == 3
end

/// Splits a list into two lists: one containing elements that satisfy the condition `f(index, element)`, and another for elements that don't.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 4]
/// list.partition(l, fun (i, x) return x % 2 == 0 end) // [[2, 4], [1, 3]]
/// ```
pub fun partition(xs, f)
  let ys = []
  let zs = []
  each(xs, fun (i, x)
    if f(i, x)
      push(ys, x)
    else
      push(zs, x)
    end
  end)
  return [ys, zs]
end

test "partition"
    let r = partition([1, 2, 3, 4], fun (i, x) return x % 2 == 0 end)
    assert r[0] == [2, 4]
    assert r[1] == [1, 3]
end

/// Pairs elements of two lists based on their index. The longer list is truncated to the shorter list's length.
///
/// Example:
/// ```vv
/// let a = [1, 2]
/// let b = ["a", "b"]
/// list.zip(a, b) // [[1, "a"], [2, "b"]]
/// ```
pub fun zip(xs, ys)
  let rs = []
  let i = 0
  let length = max([len(xs), len(ys)], fun (it) return it end)
  while i < length
    let x = option.none
    if i < len(xs)
      x = xs[i]
    end

    let y = option.none
    if i < len(ys)
      y = ys[i]
    end

    push(rs, [x, y])

    i += 1
  end
  return rs
end

test "zip"
    let r = zip([1, 2], ["a", "b"])
    assert r == [[1, "a"], [2, "b"]]
    // Unequal lengths
    let r2 = zip([1, 2, 3], ["x"])
    assert r2 == [[1, "x"], [2, option.none], [3, option.none]]
end

/// Checks if all elements in the list satisfy the applied condition `f(index, element)`.
///
/// Example:
/// ```vv
/// let l = [2, 4, 6]
/// list.every(l, fun (i, x) return x % 2 == 0 end) // true
/// ```
pub fun every(xs, f)
  let i = 0
  while i < len(xs)
    if not(f(i, xs[i]))
      return false
    end
    i += 1
  end
  return true
end

test "every"
    assert every([2, 4, 6], fun (i, x) return x % 2 == 0 end) == true
    assert every([2, 3, 6], fun (i, x) return x % 2 == 0 end) == false
    assert every([], fun (i, x) return false end) == true
end

/// Checks if at least one element in the list satisfies the applied condition `f(index, element)`.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.some(l, fun (i, x) return x % 2 == 0 end) // true
/// ```
pub fun some(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return true
    end
    i += 1
  end
  return false
end

test "some"
    assert some([1, 2, 3], fun (i, x) return x % 2 == 0 end) == true
    assert some([1, 3, 5], fun (i, x) return x % 2 == 0 end) == false
    assert some([], fun (i, x) return true end) == false
end

/// Returns the first element in the list that satisfies the condition `f(index, element)`.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.find(l, fun (i, x) return x % 2 == 0 end) // 2
/// ```
pub fun find(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return xs[i]
    end
    i += 1
  end
  return option.none
end

test "find"
    assert find([1, 2, 3], fun (i, x) return x % 2 == 0 end) == 2
    assert find([1, 3, 5], fun (i, x) return x % 2 == 0 end) == option.none
end

/// Returns the index of the first element in the list that satisfies the condition `f(index, element)`.
/// Returns `-1` if no such element is found.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3]
/// list.find_index(l, fun (i, x) return x % 2 == 0 end) // 1
/// ```
pub fun find_index(xs, f)
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      return i
    end
    i += 1
  end
  return option.none
end

test "find_index"
    assert find_index([1, 2, 3], fun (i, x) return x % 2 == 0 end) == 1
    assert find_index([1, 3, 5], fun (i, x) return x % 2 == 0 end) == option.none
end

/// Searches for a sub-list pattern within the list and returns the start index.
/// Returns `-1` if not found.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 4]
/// list.find_pattern(l, [2, 3]) // 1
/// ```
pub fun find_pattern(xs, ys)
  let i = 0
  while i < len(xs)
    if xs[i] == ys[0]
      let j = 1
      while j < len(ys)
        if not(xs[i + j] == ys[j])
          break
        end
        j = j + 1
      end
      if j == len(ys)
        return i
      end
    end
    i += 1
  end
  return -1
end

test "find_pattern"
    assert find_pattern([1, 2, 3, 4], [2, 3]) == 1
    assert find_pattern([1, 2, 3, 4], [5]) == -1
    assert find_pattern([1, 2, 3, 1, 2], [1, 2]) == 0
end

/// Takes elements from the beginning of the list as long as they satisfy the condition `f(index, element)`.
/// Stops at the first element that fails the condition.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 4]
/// list.take_while(l, fun (i, x) return x < 3 end) // [1, 2]
/// ```
pub fun take_while(xs, f)
  let rs = []
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      push(rs, xs[i])
    else
      break
    end
    i += 1
  end
  return rs
end

test "take_while"
    assert take_while([1, 2, 3, 4], fun (i, x) return x < 3 end) == [1, 2]
    assert take_while([3, 4], fun (i, x) return x < 3 end) == []
    assert take_while([1, 2], fun (i, x) return x < 3 end) == [1, 2]
end

/// Drops elements from the beginning of the list as long as they satisfy the condition `f(index, element)`.
/// Returns the remaining elements starting from the first element that fails the condition.
///
/// Example:
/// ```vv
/// let l = [1, 2, 3, 4]
/// list.drop_while(l, fun (i, x) return x < 3 end) // [3, 4]
/// ```
pub fun drop_while(xs, f)
  let rs = []
  let i = 0
  while i < len(xs)
    if f(i, xs[i])
      i += 1
    else
      break
    end
  end
  while i < len(xs)
    push(rs, xs[i])
    i += 1
  end
  return rs
end

test "drop_while"
    assert drop_while([1, 2, 3, 4], fun (i, x) return x < 3 end) == [3, 4]
    assert drop_while([1, 2], fun (i, x) return x < 3 end) == []
    assert drop_while([3, 4], fun (i, x) return x < 3 end) == [3, 4]
end
