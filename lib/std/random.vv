/// The `random` module provides functions for generating random numbers and making random choices.
///
/// Example:
/// ```vv
/// import random from "std/random.vv"
///
/// random.seed(42)
/// let n = random.int(1, 100)
/// let x = random.choice(["a", "b", "c"])
/// ```

import option from "std/option.vv"

/// Seeds the random number generator with the given integer.
///
/// Example:
/// ```vv
/// random.seed(42)
/// ```
pub extern "native" fun seed(n)

/// Returns a random floating-point number in the range [0.0, 1.0).
///
/// Example:
/// ```vv
/// let f = random.float()
/// ```
pub extern "native" fun float()

test "float"
    let f = float()
    assert 0.0 <= f
    assert f < 1.0
end

/// Returns a random integer in the range [min, max) (exclusive).
///
/// Example:
/// ```vv
/// let n = random.int(1, 10) // Returns 1-9
/// ```
pub extern "native" fun int(min, max)

test "int"
    let i = int(1, 10)
    assert 1 <= i
    assert i < 10
end

test "seed reproducibility"
    seed(42)
    let f1 = float()
    seed(42)
    let f2 = float()
    assert f1 == f2
end

/// Returns a random element from the given list.
///
/// Example:
/// ```vv
/// let x = random.choice([1, 2, 3])
/// ```
pub fun choice(xs)
    if len(xs) == 0
        return option.none
    end
    let i = int(0, len(xs))
    return xs[i]
end

test "choice"
    let xs = [1, 2, 3]
    let c = choice(xs)
    let ok = false
    if c == 1 ok = true end
    if c == 2 ok = true end
    if c == 3 ok = true end
    assert ok
end

test "choice empty"
    let xs = []
    assert choice(xs) == option.none
end
