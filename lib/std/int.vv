/// The `int` module provides standard utilities for integer numbers.
///
/// Example:
/// ```vv
/// import int from "std/int.vv"
///
/// int.to_string(42) // "42"
/// int.abs(-5)       // 5
/// ```


/// Converts an integer to its string representation.
///
/// Example:
/// ```vv
/// int.to_string(42) // "42"
/// ```
pub extern "native" fun to_string(i)

test "to_string"
    assert to_string(42) == "42"
    assert to_string(0) == "0"
    assert to_string(-7) == "-7"
end

/// Returns the absolute value of `n`.
///
/// Example:
/// ```vv
/// int.abs(-5) // 5
/// int.abs(5)  // 5
/// ```
pub extern "native" fun abs(n)

test "abs"
    assert abs(-5) == 5
    assert abs(5) == 5
    assert abs(0) == 0
end

/// Returns the smaller of `a` and `b`.
///
/// Example:
/// ```vv
/// int.min(10, 5) // 5
/// ```
pub extern "native" fun min(a, b)

test "min"
    assert min(10, 5) == 5
    assert min(5, 10) == 5
    assert min(3, 3) == 3
end

/// Returns the larger of `a` and `b`.
///
/// Example:
/// ```vv
/// int.max(10, 5) // 10
/// ```
pub extern "native" fun max(a, b)

test "max"
    assert max(10, 5) == 10
    assert max(5, 10) == 10
    assert max(3, 3) == 3
end
