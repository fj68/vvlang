/// The `record` module provides utilities for working with records (key-value maps).
/// Records are unordered collections of fields, where keys are typically strings or integers.
///
/// Example:
/// ```vv
/// import record from "std/record.vv"
///
/// let r = { a = 1, b = 2 }
/// record.set(r, "c", 3)
/// let keys = record.keys(r)
/// ```


import list from "./list.vv"

/// Gets the value associated with the given key in a record.
/// Returns `none` if the key does not exist.
///
/// Example:
/// ```vv
/// let r = {a: 1}
/// record.get(r, "a") // 1
/// record.get(r, "b") // none
/// ```
pub extern "native" fun get(r, k)

test "get"
    let r = { a = 1, b = 2 }
    assert get(r, "a") == 1
    assert get(r, "b") == 2
    assert get(r, "c") == none
end

/// Sets the value for the given key in a record, modifying it in place.
/// Returns the modified record.
///
/// Example:
/// ```vv
/// let r = {}
/// record.set(r, "a", 1) // {a: 1}
/// ```
pub extern "native" fun set(r, k, v)

test "set"
    let r = {}
    set(r, "x", 42)
    assert get(r, "x") == 42
    set(r, "x", 99)
    assert get(r, "x") == 99
end

/// Converts a record to a list of key-value pairs (each pair is a list of [key, value]).
///
/// Example:
/// ```vv
/// let r = {a: 1, b: 2}
/// record.to_list(r) // [["a", 1], ["b", 2]]
/// ```
pub extern "native" fun to_list(r)

test "to_list"
    let r = { a = 1 }
    let pairs = to_list(r)
    assert len(pairs) == 1
    assert pairs[0][0] == "a"
    assert pairs[0][1] == 1
end

/// Returns a list of all keys in the record.
///
/// Example:
/// ```vv
/// let r = {a: 1, b: 2}
/// record.keys(r) // ["a", "b"]
/// ```
pub fun keys(r)
  list.map(to_list(r), fun (i, kv)
    kv[0]
  end)
end

test "keys"
    let r = { foo = 1, bar = 2 }
    let ks = keys(r)
    assert len(ks) == 2
end

/// Returns a list of all values in the record.
///
/// Example:
/// ```vv
/// let r = {a: 1, b: 2}
/// record.values(r) // [1, 2]
/// ```
pub fun values(r)
  list.map(to_list(r), fun (i, kv)
    kv[1]
  end)
end

test "values"
    let r = { x = 10 }
    let vs = values(r)
    assert len(vs) == 1
    assert vs[0] == 10
end

/// Checks if the record contains the specified key.
///
/// Example:
/// ```vv
/// let r = {foo: "bar"}
/// record.has(r, "foo") // true
/// record.has(r, "baz") // false
/// ```
pub fun has(r, k)
  list.some(keys(r), fun (i, x)
    x == k
  end)
end

test "has"
    let r = { a = 1, b = 2 }
    assert has(r, "a") == true
    assert has(r, "b") == true
    assert has(r, "c") == false
end
