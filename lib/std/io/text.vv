/// The `io/text` module provides a buffered text reader using an encoding.
///
/// Example:
/// ```vv
/// import text from "std/io/text.vv"
/// import file from "std/fs/file.vv"
/// import utf8 from "std/encoding/utf8.vv"
///
/// let f = file.reader("test.txt")!
/// let r = text.reader(f, utf8)!
/// // text.close also closes the internal reader (f), so no need for a separate defer for f.
/// defer text.close(r)
/// let line = text.read_line(r)!
/// ```


import bytes from "std/io/bytes.vv"
import list from "std/list.vv"
import result from "std/result.vv"
import file from "std/fs/file.vv"
import utf8 from "std/encoding/utf8.vv"

/// Closes the reader.
///
/// - `r`: The reader record.
///
pub fun close(r)
    return r.b_reader.close(r.b_reader)
end

/// Reads a single character from the reader.
///
/// - `r`: The text reader record.
///
/// Returns a result containing a record `{ char = c, size = n }`.
pub fun read(r)
    let peek_bytes_res = r.b_reader.peek(r.b_reader, 4)
    let peek_bytes = peek_bytes_res.value
    if len(peek_bytes) == 0
        return result.error("EOF")
    end

    let dec_res = r.encoding.decode(peek_bytes)
    if result.is_error(dec_res)
        return dec_res
    end

    let entry = dec_res.value
    // Advance b_reader by entry.size
    let _ = r.b_reader.read(r.b_reader, entry.size)!
    return result.ok({ char = entry.char, size = entry.size })
end

/// Peeks a single character without advancing the position.
///
/// - `r`: The text reader record.
///
/// Returns a result containing a record `{ char = c, size = n }`.
pub fun peek(r)
    let peek_bytes_res = r.b_reader.peek(r.b_reader, 4)
    let peek_bytes = peek_bytes_res.value
    if len(peek_bytes) == 0
        return result.error("EOF")
    end

    return r.encoding.decode(peek_bytes)
end

/// Reads a line from the reader.
///
/// - `r`: The text reader record.
///
/// Returns a result containing a list of characters (excluding line breaks).
pub fun read_line(r)
    let res = []
    while true
        let dec_res = read(r)
        if result.is_error(dec_res)
            if 0 < len(res)
                return result.ok(res)
            end
            return dec_res
        end
        let c = dec_res.value.char
        if c == '\n'
            break
        end
        if c == '\r'
            // Peek next to see if it's \n
            let next_res = peek(r)
            if result.is_ok(next_res) and next_res.value.char == '\n'
                let _ = read(r)! // consume \n
            end
            break
        end
        list.push(res, c)
    end
    return result.ok(res)
end

/// Reads all remaining content as a list of characters.
///
/// - `r`: The text reader record.
///
/// Returns a result containing a list of characters.
pub fun read_all(r)
    let res = []
    while true
        let dec_res = read(r)
        if result.is_error(dec_res)
            break
        end
        list.push(res, dec_res.value.char)
    end
    return result.ok(res)
end

/// Creates a buffered text reader using an encoding.
///
/// - `source_reader`: An object with a `read(length)` method.
/// - `encoding_module`: An encoding module (e.g., `utf8` or `sjis`).
///
/// Returns a result containing a text reader record.
pub fun reader(source_reader, encoding_module)
    let b_reader_res = bytes.reader(source_reader, 4096)
    let b_reader = b_reader_res.value
    return result.ok({
        b_reader = b_reader,
        encoding = encoding_module,
        read = read,
        peek = peek,
        close = close,
    })
end

test "reader / read"
    let path = "tmp_test_text_read_inline.txt"
    let f = file.create(path)!
    defer file.remove(path)
    defer file.close(f)
    file.write(f, [97, 226, 130, 172, 10])! // a€\n

    let source = file.reader(path)!
    let r = reader(source, utf8)!
    defer close(r)

    let c1 = read(r)!
    assert c1.char == 'a'

    let c2 = read(r)!
    assert c2.char == '€'

    let c3 = read(r)!
    assert c3.char == '\n'
end

test "peek"
    let path = "tmp_test_text_peek_inline.txt"
    let f = file.create(path)!
    defer file.remove(path)
    defer file.close(f)
    file.write(f, [65, 66])! // AB

    let source = file.reader(path)!
    let r = reader(source, utf8)!
    defer close(r)

    let p1 = peek(r)!
    assert p1.char == 'A'

    // Position should not advance
    let p2 = peek(r)!
    assert p2.char == 'A'

    let c1 = read(r)!
    assert c1.char == 'A'
end

test "read_line"
    let path = "tmp_test_text_line_inline.txt"
    let f = file.create(path)!
    defer file.remove(path)
    defer file.close(f)
    file.write(f, [97, 98, 10, 99, 100])! // ab\ncd

    let source = file.reader(path)!
    let r = reader(source, utf8)!
    defer close(r)

    let l1 = read_line(r)!
    assert l1 == ['a', 'b']

    let l2 = read_line(r)!
    assert l2 == ['c', 'd']
end

test "read_all"
    let path = "tmp_test_text_all_inline.txt"
    let f = file.create(path)!
    defer file.remove(path)
    defer file.close(f)
    file.write(f, [104, 105])! // hi

    let source = file.reader(path)!
    let r = reader(source, utf8)!
    defer close(r)

    let all = read_all(r)!
    assert all == ['h', 'i']
end
