/// The `result` module handles operations that can succeed with a value (`ok`) or fail with an error (`error`).
///
/// Example:
/// ```vv
/// import result from "std/result.vv"
///
/// let r = result.ok(42)
/// if result.is_ok(r)
///     console.print(r.value)
/// end
/// ```


import option from "std/option.vv"

/// Returns a successful result containing `value`.
///
/// Example:
/// ```vv
/// let r = result.ok(10)
/// ```
pub fun ok(value)
  return { type = "ok", value = value }
end

test "ok"
    let r = ok(10)
    assert r.type == "ok"
    assert r.value == 10
end

/// Returns a failure result containing an error `value`.
///
/// Example:
/// ```vv
/// let e = result.error("something went wrong")
/// ```
pub fun error(value)
  return { type = "error", value = value }
end

test "error"
    let e = error("oops")
    assert e.type == "error"
    assert e.value == "oops"
end

/// Checks if the result is successful (`ok`).
///
/// Example:
/// ```vv
/// result.is_ok(result.ok(1))    // true
/// result.is_ok(result.error(1)) // false
/// ```
pub fun is_ok(v)
  return v.type == "ok"
end

test "is_ok"
    assert is_ok(ok(1)) == true
    assert is_ok(error(1)) == false
end

/// Checks if the result is a failure (`error`).
///
/// Example:
/// ```vv
/// result.is_error(result.error(1)) // true
/// result.is_error(result.ok(1))    // false
/// ```
pub fun is_error(v)
  return v.type == "error"
end

test "is_error"
    assert is_error(error(1)) == true
    assert is_error(ok(1)) == false
end

/// Applies `f` to the value of an `ok` result.
///
/// Example:
/// ```vv
/// result.map(result.ok(2), fun(x) x * 2 end) // ok(4)
/// ```
pub fun map(v, f)
  if is_ok(v)
    return ok(f(v.value))
  end
  return v
end

test "map"
    let double = fun(x) x * 2 end
    let r1 = map(ok(3), double)
    assert r1.type == "ok"
    assert r1.value == 6
    let r2 = map(error("e"), double)
    assert r2.type == "error"
end

/// Applies a function `f` that returns a result to the value of an `ok` result.
///
/// Example:
/// ```vv
/// result.flat_map(result.ok(1), fun(x) result.ok(x + 1) end) // ok(2)
/// ```
pub fun flat_map(v, f)
  if is_ok(v)
    return f(v.value)
  end
  return v
end

test "flat_map"
    let f = fun(x) ok(x + 1) end
    let r1 = flat_map(ok(1), f)
    assert r1.type == "ok"
    assert r1.value == 2
    let r2 = flat_map(error("e"), f)
    assert r2.type == "error"
end

/// Applies `f` to the value of an `error` result.
///
/// Example:
/// ```vv
/// result.map_error(result.error("fail"), fun(e) e + "!" end) // error("fail!")
/// ```
pub fun map_error(v, f)
  if is_error(v)
    return error(f(v.value))
  end
  return v
end

test "map_error"
    let r1 = map_error(error("fail"), fun(e) e + "!" end)
    assert r1.type == "error"
    assert r1.value == "fail!"
    let r2 = map_error(ok(1), fun(e) e + "!" end)
    assert r2.type == "ok"
end

/// Applies a function `f` that returns a result to the value of an `error` result.
///
/// Example:
/// ```vv
/// result.flat_map_error(result.error(1), fun(e) result.error(e + 1) end) // error(2)
/// ```
pub fun flat_map_error(v, f)
  if is_error(v)
    return f(v.value)
  end
  return v
end

test "flat_map_error"
    let r1 = flat_map_error(error(1), fun(e) error(e + 1) end)
    assert r1.type == "error"
    assert r1.value == 2
    let r2 = flat_map_error(ok(5), fun(e) error(e + 1) end)
    assert r2.type == "ok"
end

/// Returns the `ok` value if it exists, otherwise returns `default_value`.
///
/// Example:
/// ```vv
/// result.get_or(result.ok(1), 0)    // 1
/// result.get_or(result.error(1), 0) // 0
/// ```
pub fun get_or(v, default_value)
  if is_ok(v)
    return v.value
  end
  return default_value
end

test "get_or"
    assert get_or(ok(1), 0) == 1
    assert get_or(error(1), 0) == 0
end

/// Returns the `error` value if it exists, otherwise returns `default_value`.
///
/// Example:
/// ```vv
/// result.get_error_or(result.error("fail"), "ok") // "fail"
/// ```
pub fun get_error_or(v, default_value)
  if is_error(v)
    return v.value
  end
  return default_value
end

test "get_error_or"
    assert get_error_or(error("fail"), "ok") == "fail"
    assert get_error_or(ok(1), "ok") == "ok"
end

/// Converts a result into an `option`.
/// `ok(v)` becomes `some(v)`, `error(v)` becomes `none`.
///
/// Example:
/// ```vv
/// result.to_option(result.ok(1))    // some(1)
/// result.to_option(result.error(1)) // none
/// ```
pub fun to_option(v)
  if is_ok(v)
    return option.some(v.value)
  end
  return option.none
end

test "to_option"
    let o1 = to_option(ok(1))
    assert o1.type == "some"
    assert o1.value == 1
    let o2 = to_option(error(1))
    assert o2.type == "none"
end

/// Converts an `option` into a result.
/// `some(v)` becomes `ok(v)`, `none` becomes `error(error_value)`.
///
/// Example:
/// ```vv
/// result.from_option(option.some(1), "fail") // ok(1)
/// result.from_option(option.none, "fail")    // error("fail")
/// ```
pub fun from_option(v, error_value)
  if option.is_some(v)
    return ok(v.value)
  end
  return error(error_value)
end

test "from_option"
    let r1 = from_option(option.some(1), "fail")
    assert r1.type == "ok"
    assert r1.value == 1
    let r2 = from_option(option.none, "fail")
    assert r2.type == "error"
    assert r2.value == "fail"
end
