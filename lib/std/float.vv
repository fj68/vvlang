/// The `float` module provides standard utilities for floating-point numbers.

/// Converts a floating-point number to its string representation.
///
/// Example:
/// ```vv
/// float.to_string(3.14) // "3.14"
/// ```
pub extern "native" fun to_string(f)

/// Returns the largest integer less than or equal to `f`.
///
/// Example:
/// ```vv
/// float.floor(3.7)  // 3.0
/// float.floor(-3.2) // -4.0
/// ```
pub extern "native" fun floor(f)

/// Returns the smallest integer greater than or equal to `f`.
///
/// Example:
/// ```vv
/// float.ceil(3.2)  // 4.0
/// float.ceil(-3.7) // -3.0
/// ```
pub extern "native" fun ceil(f)

/// Converts an integer to a floating-point number.
///
/// Example:
/// ```vv
/// float.from_int(42) // 42.0
/// ```
pub extern "native" fun from_int(i)
