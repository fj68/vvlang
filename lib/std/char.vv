/// The `char` module provides utilities for working with characters.
/// Characters are typically represented by single quotes.
///
/// Example:
/// ```vv
/// import char from "std/char.vv"
///
/// char.to_upper('a') // 'A'
/// char.is_digit('1') // true
/// ```


/// Converts a character to its uppercase equivalent.
///
/// Example:
/// ```vv
/// char.to_upper('a') // 'A'
/// char.to_upper('1') // '1'
/// ```
pub extern 'native' fun to_upper(c)

test "to_upper"
    assert to_upper('a') == 'A'
    assert to_upper('z') == 'Z'
    assert to_upper('A') == 'A'
    assert to_upper('1') == '1'
end

/// Converts a character to its lowercase equivalent.
///
/// Example:
/// ```vv
/// char.to_lower('A') // 'a'
/// char.to_lower('!') // '!'
/// ```
pub extern 'native' fun to_lower(c)

test "to_lower"
    assert to_lower('A') == 'a'
    assert to_lower('Z') == 'z'
    assert to_lower('a') == 'a'
    assert to_lower('!') == '!'
end

/// Checks if a character is an ASCII decimal digit ('0'-'9').
///
/// Example:
/// ```vv
/// char.is_digit('5') // true
/// char.is_digit('a') // false
/// ```
pub extern 'native' fun is_digit(c)

test "is_digit"
    assert is_digit('0') == true
    assert is_digit('9') == true
    assert is_digit('5') == true
    assert is_digit('a') == false
    assert is_digit(' ') == false
end

/// Checks if a character is a whitespace character (e.g., space, tab, newline).
///
/// Example:
/// ```vv
/// char.is_space(' ')  // true
/// char.is_space('\n') // true
/// char.is_space('a')  // false
/// ```
pub extern 'native' fun is_space(c)

test "is_space"
    assert is_space(' ') == true
    assert is_space('\n') == true
    assert is_space('\t') == true
    assert is_space('a') == false
    assert is_space('1') == false
end
