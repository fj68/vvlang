import file from 'std/fs/file.vv'
import dir from 'std/fs/dir.vv'
import result from 'std/result.vv'

let test_dir = "test_fs_dir"
let test_file = "test_fs_dir/test.txt"

// Setup
let res_dir = dir.create(test_dir)
assert result.is_ok(res_dir)
assert result.get_or(dir.exists(test_dir), false)

// File operations
let res_fd = file.create(test_file)
assert result.is_ok(res_fd)
let fd = result.get_or(res_fd, 0)
assert result.get_or(file.exists(test_file), false)

// Write
let res_w = file.writer(test_file, false)
assert result.is_ok(res_w)
let w = result.get_or(res_w, 0)
let res_write = w.write(w, "hello world!")
assert result.is_ok(res_write)
file.close(fd)
w.close(w)

// Read
let res_r = file.reader(test_file)
assert result.is_ok(res_r)
let r = result.get_or(res_r, 0)
let res_content = r.read(r, 12)
assert result.is_ok(res_content)
assert result.get_or(res_content, []) == [104, 101, 108, 108, 111, 32, 119, 111, 114, 108, 100, 33]
r.close(r)

// Dir read
let res_files = dir.read(test_dir)
assert result.is_ok(res_files)
let files = result.get_or(res_files, [])
assert len(files) == 1
assert files[0] == "test.txt"

// Cleanup
dir.remove(test_dir)
assert result.get_or(dir.exists(test_dir), true) == false
