import console from 'std/console.vv'

// let's define very simple function
fun add(a, b)
  return a + b
end

// define variable
x = 0

// here, another simple function
fun incr_x()
  // variables are mutable
  x = x + 1
end

if x < 10
  console.print('x is less than 10.')
end

// call some functions
incr_x()
console.print(x)  // 1
