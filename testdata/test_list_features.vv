// List Support Features Test
import list from 'std/list.vv'
import console from 'std/console.vv'

// Index access
let xs = [10, 20, 30, 40, 50]
console.print(xs[0])   // 10
console.print(xs[2])   // 30
console.print(xs[-1])  // 50 (negative indexing)
console.print(xs[-2])  // 40

// Slicing with omittable start and end
console.print(xs[1:3])    // [20, 30]
console.print(xs[2:])     // [30, 40, 50] (omit end)
console.print(xs[:3])     // [10, 20, 30] (omit start)
console.print(xs[:])      // [10, 20, 30, 40, 50] (full slice)

// String indexing and slicing
let text = 'hello'
console.print(text[0])    // "h"
console.print(text[1:4])  // "ell"
console.print(text[:2])   // "he"
console.print(text[3:])   // "lo"
console.print(text[-1])   // "o"
