import list from 'std/list.vv'
import console from 'std/console.vv'

let xs = [1, 2, 3, 2, 4]
let ys = [2]
let zs = [9, 9]

console.print("Replaced xs [2] with [9, 9]:")
console.print(list.replace(xs, ys, zs))

let xs2 = [1, 2, 3, 1, 2, 3]
let ys2 = [1, 2]
let zs2 = [0]
console.print("Replaced [1, 2, 3, 1, 2, 3] pattern [1, 2] with [0]:")
console.print(list.replace(xs2, ys2, zs2))

// Test shift
let s = [10, 20, 30]
let first = list.shift(s)
console.print("Shifted first from [10, 20, 30]:")
console.print(first)
console.print("List after shift:")
console.print(s)

// Test unshift
list.unshift(s, 5)
console.print("List after unshifting 5:")
console.print(s)

// Test <= operator (now fixed in parser)
let a = 10
let b = 20
if a <= b
  console.print("10 <= 20 is true")
end
