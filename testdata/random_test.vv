import random from "std/random.vv"
import option from "std/option.vv"

test "random.int"
    let i = random.int(1, 10)
    assert 1 <= i
    assert i < 10
end

test "random.float"
    let f = random.float()
    assert 0.0 <= f
    assert f < 1.0
end

test "random.seed"
    random.seed(42)
    let f1 = random.float()
    random.seed(42)
    let f2 = random.float()
    assert f1 == f2
end

test "random.choice"
    let xs = [1, 2, 3]
    let c = random.choice(xs)
    let ok = false
    if c == 1 ok = true end
    if c == 2 ok = true end
    if c == 3 ok = true end
    assert ok
end

test "random.choice empty"
    let xs = []
    assert random.choice(xs) == option.none
end
